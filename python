from __future__ import annotations

import logging
from typing import Any, Generator

import requests

from src.utils import sleep_until


logger = logging.getLogger(__name__)


class GitHubClient:
    def __init__(
        self,
        token: str | None,
        base_url: str = "https://api.github.com",
        api_version: str = "2022-11-28",
        user_agent: str = "github-open-source-trends/1.0",
        timeout_s: int = 30,
    ) -> None:
        self.base_url = base_url.rstrip("/")
        self.api_version = api_version
        self.timeout_s = timeout_s

        self.session = requests.Session()
        self.session.headers.update(
            {
                "Accept": "application/vnd.github+json",
                "X-GitHub-Api-Version": self.api_version,
                "User-Agent": user_agent,
            }
        )
        if token:
            self.session.headers.update({"Authorization": f"Bearer {token}"})

    def _request(self, method: str, url: str, **kwargs: Any) -> requests.Response:
        for attempt in range(1, 6):
            resp = self.session.request(method, url, timeout=self.timeout_s, **kwargs)

            # Handle rate limit (403 can indicate secondary rate limit too)
            if resp.status_code in (403, 429):
                remaining = resp.headers.get("X-RateLimit-Remaining")
                reset = resp.headers.get("X-RateLimit-Reset")

                # If primary rate limit is reached, wait until reset
                if remaining == "0" and reset:
                    logger.warning(
                        "Rate limit hit. Sleeping until reset (epoch=%s).", reset
                    )
                    sleep_until(int(reset))
                    continue

                # Secondary rate limit: exponential backoff
                backoff = min(60, 2**attempt)
                logger.warning(
                    "Possible secondary rate limit or throttling (%s). Backing off %ss.",
                    resp.status_code,
                    backoff,
                )
                import time

                time.sleep(backoff)
                continue

            if resp.status_code >= 500:
                backoff = min(30, 2**attempt)
                logger.warning("Server error %s. Retrying in %ss.", resp.status_code, backoff)
                import time

                time.sleep(backoff)
                continue

            return resp

        resp.raise_for_status()
        return resp

    def _paginate(
        self,
        url: str,
        params: dict[str, Any] | None = None,
        per_page: int = 100,
        max_items: int = 200,
        extra_headers: dict[str, str] | None = None,
    ) -> Generator[dict[str, Any], None, None]:
        page = 1
        yielded = 0
        while True:
            merged_params = dict(params or {})
            merged_params.update({"per_page": per_page, "page": page})

            headers = dict(self.session.headers)
            if extra_headers:
                headers.update(extra_headers)

            resp = self._request("GET", url, params=merged_params, headers=headers)

            if resp.status_code != 200:
                logger.error("Request failed: %s %s", resp.status_code, resp.text[:2000])
                resp.raise_for_status()

            data = resp.json()
            items = data if isinstance(data, list) else data.get("items", [])
            if not items:
                break

            for item in items:
                yield item
                yielded += 1
                if yielded >= max_items:
                    return

            page += 1

    def search_repositories(
        self,
        query: str,
        sort: str = "stars",
        order: str = "desc",
        max_items: int = 200,
    ) -> list[dict[str, Any]]:
        url = f"{self.base_url}/search/repositories"
        params = {"q": query, "sort": sort, "order": order}
        return list(self._paginate(url, params=params, per_page=100, max_items=max_items))

    def get_repository(self, owner: str, repo: str) -> dict[str, Any]:
        url = f"{self.base_url}/repos/{owner}/{repo}"
        resp = self._request("GET", url)
        resp.raise_for_status()
        return resp.json()

    def get_languages(self, owner: str, repo: str) -> dict[str, int]:
        url = f"{self.base_url}/repos/{owner}/{repo}/languages"
        resp = self._request("GET", url)
        if resp.status_code == 404:
            return {}
        resp.raise_for_status()
        return resp.json()

    def list_commits(
        self,
        owner: str,
        repo: str,
        max_items: int = 50,
    ) -> list[dict[str, Any]]:
        url = f"{self.base_url}/repos/{owner}/{repo}/commits"
        return list(self._paginate(url, params={}, per_page=100, max_items=max_items))

    def list_issues(
        self,
        owner: str,
        repo: str,
        state: str = "all",
        max_items: int = 50,
    ) -> list[dict[str, Any]]:
        # Note: This endpoint returns PRs too; we filter in code.
        url = f"{self.base_url}/repos/{owner}/{repo}/issues"
        params = {"state": state}
        return list(self._paginate(url, params=params, per_page=100, max_items=max_items))

    def list_contributors(
        self,
        owner: str,
        repo: str,
        max_items: int = 50,
    ) -> list[dict[str, Any]]:
        url = f"{self.base_url}/repos/{owner}/{repo}/contributors"
        return list(self._paginate(url, params={}, per_page=100, max_items=max_items))

    def list_stargazers_with_timestamps(
        self,
        owner: str,
        repo: str,
        max_items: int = 200,
    ) -> list[dict[str, Any]]:
        # Requires custom accept header to include `starred_at`
        url = f"{self.base_url}/repos/{owner}/{repo}/stargazers"
        extra_headers = {"Accept": "application/vnd.github.star+json"}
        return list(
            self._paginate(
                url,
                params={},
                per_page=100,
                max_items=max_items,
                extra_headers=extra_headers,
            )
        )
